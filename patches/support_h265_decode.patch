+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#import "RTCVideoDecoderFactoryH264H265.h"
+
+#import "RTCVideoDecoderFactoryH264.h"
+#import "RTCVideoDecoderH265.h"
+
+@implementation RTC_OBJC_TYPE (RTCVideoDecoderFactoryH264H265) {
+  RTC_OBJC_TYPE(RTCVideoDecoderFactoryH264) *_h264Factory;
+}
+
+- (instancetype)init {
+  self = [super init];
+  if (self) {
+    _h264Factory = [[RTC_OBJC_TYPE(RTCVideoDecoderFactoryH264) alloc] init];
+  }
+  return self;
+}
+
+- (NSArray<RTC_OBJC_TYPE(RTCVideoCodecInfo) *> *)supportedCodecs {
+  NSMutableArray<RTC_OBJC_TYPE(RTCVideoCodecInfo) *> *codecs =
+      [[_h264Factory supportedCodecs] mutableCopy];
+  [codecs
+      addObjectsFromArray:[RTC_OBJC_TYPE(RTCVideoDecoderH265) supportedCodecs]];
+  return [codecs copy];
+}
+
+- (id<RTC_OBJC_TYPE(RTCVideoDecoder)>)createDecoder:
+    (RTC_OBJC_TYPE(RTCVideoCodecInfo) *)info {
+  if ([info.name isEqualToString:kRTCVideoCodecH265Name]) {
+    return [[RTC_OBJC_TYPE(RTCVideoDecoderH265) alloc] init];
+  }
+  return [_h264Factory createDecoder:info];
+}
+
+@end
